{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types",
      "vite/client",
      "@cloudflare/vitest-plugin/types"
    ],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": ["src", "worker", "tests", "vite.config.ts", "vitest.config.ts"]
}
